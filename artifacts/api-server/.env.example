# --- Base de donnees ---
DATABASE_URL=postgresql://talkie:talkie@localhost:5432/talkie

# --- Authentification ---
# Genere une valeur longue et aleatoire en production, ex. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Serveur ---
PORT=4000
NODE_ENV=development

# Origine autorisee pour les requetes cross-origin (frontend Vite en dev)
CORS_ORIGIN=http://localhost:5173

# --- Web Push (Phase 9, section 11) ---
# Optionnelles : le serveur demarre sans elles, mais les notifications push
# restent desactivees. Generer une paire de cles avec :
#   npm run vapid:generate
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:contact@talkie.app
